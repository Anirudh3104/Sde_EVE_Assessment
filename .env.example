# Copy to .env and adjust. docker-compose reads these values.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://eve:eve@db:5432/eve
TEST_DATABASE_URL=postgresql+asyncpg://eve:eve@db:5432/eve_test
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

WEBHOOK_SECRET=change-me-webhook-secret
WEBHOOK_TARGET_URL=http://localhost:8000/payments/webhook/
PAYMENT_SUCCESS_RATE=0.8
PROVIDER_DELAY_SECONDS=1.0
SIMULATE_DUPLICATE_WEBHOOKS=false

CACHE_TTL_SECONDS=300
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO
LOG_JSON=true
